@model CitasApp.Models.Paciente
@{
    ViewData["Title"] = $"{Model.Nombre} {Model.Apellido}";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">&#128100; @Model.Nombre @Model.Apellido</h4>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Teléfono</dt>
                    <dd class="col-sm-8">@Model.Telefono</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&#8592; Volver</a>
                <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">Editar</a>
                <a asp-controller="Cita" asp-action="PorPaciente" asp-route-pacienteId="@Model.Id" class="btn btn-info btn-sm">Ver Citas</a>
            </div>
        </div>
    </div>
</div>
