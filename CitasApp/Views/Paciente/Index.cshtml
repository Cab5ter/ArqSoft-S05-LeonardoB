@model List<CitasApp.Models.Paciente>

<h1>Pacientes</h1>
<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nombre completo</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Nombre @p.Apellido</td>
                <td>@p.Email</td>
                <td><a asp-action="Detalle" asp-route-id="@p.Id">Ver detalle</a></td>
            </tr>
        }
    </tbody>
</table>
