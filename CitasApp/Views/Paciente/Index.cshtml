@model List<CitasApp.Models.Paciente>
@{
    ViewData["Title"] = "Pacientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold text-primary mb-0">&#128100; Pacientes</h2>
    <a asp-action="Crear" class="btn btn-success">+ Nuevo Paciente</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-primary">
                <tr>
                    <th>#</th>
                    <th>Nombre Completo</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="text-muted">@p.Id</td>
                        <td class="fw-semibold">@p.Nombre @p.Apellido</td>
                        <td>@p.Email</td>
                        <td>@p.Telefono</td>
                        <td class="text-center">
                            <a asp-action="Detalle" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info me-1">Ver</a>
                            <a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning me-1">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@p.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar a @p.Nombre @p.Apellido?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No hay pacientes registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
