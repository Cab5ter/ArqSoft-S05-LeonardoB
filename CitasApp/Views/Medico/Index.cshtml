@model List<CitasApp.Models.Medico>
@{
    ViewData["Title"] = "Médicos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold text-primary mb-0">&#127973; Médicos</h2>
    <a asp-action="Crear" class="btn btn-success">+ Nuevo Médico</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-primary">
                <tr>
                    <th>#</th>
                    <th>Nombre Completo</th>
                    <th>Especialidad</th>
                    <th>Licencia</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td class="text-muted">@m.Id</td>
                        <td class="fw-semibold">@m.NombreCompleto</td>
                        <td>@m.Especialidad</td>
                        <td><code>@m.NumeroLicencia</code></td>
                        <td class="text-center">
                            <a asp-action="Detalle" asp-route-id="@m.Id" class="btn btn-sm btn-outline-info me-1">Ver</a>
                            <a asp-action="Editar" asp-route-id="@m.Id" class="btn btn-sm btn-outline-warning me-1">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@m.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar a @m.NombreCompleto?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No hay médicos registrados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
