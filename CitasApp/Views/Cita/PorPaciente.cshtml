@model List<CitasApp.Models.Cita>

@{
    var paciente = Model.FirstOrDefault()?.Paciente;
}

<h1>Citas de @paciente?.Nombre @paciente?.Apellido</h1>
<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Paciente</th>
            <th>Médico</th>
            <th>Motivo</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@c.Hora.ToString("HH:mm")</td>
                <td>@c.Paciente?.Nombre @c.Paciente?.Apellido</td>
                <td>@c.Medico?.NombreCompleto</td>
                <td>@c.Motivo</td>
                <td>@c.Estado</td>
            </tr>
        }
    </tbody>
</table>
<a asp-controller="Paciente" asp-action="Index">← Volver a pacientes</a>
