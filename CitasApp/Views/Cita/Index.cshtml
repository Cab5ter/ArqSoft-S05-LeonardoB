@model List<CitasApp.Models.Cita>
@{
    ViewData["Title"] = "Citas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold text-primary mb-0">&#128197; Agenda de Citas</h2>
    <a asp-action="Crear" class="btn btn-success">+ Nueva Cita</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-primary">
                <tr>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Paciente</th>
                    <th>Médico</th>
                    <th>Motivo</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@c.Hora.ToString("HH:mm")</td>
                        <td>@c.Paciente?.Nombre @c.Paciente?.Apellido</td>
                        <td>@c.Medico?.NombreCompleto</td>
                        <td>@c.Motivo</td>
                        <td>
                            @{
                                var badgeClass = c.Estado switch
                                {
                                    CitasApp.Models.EstadoCita.Confirmada => "bg-success",
                                    CitasApp.Models.EstadoCita.Cancelada => "bg-danger",
                                    _ => "bg-warning text-dark"
                                };
                            }
                            <span class="badge @badgeClass">@c.Estado</span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Editar" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning me-1">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@c.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar esta cita?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No hay citas registradas.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
